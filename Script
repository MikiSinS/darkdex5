if Library then
    Library:Unload()
end
local repo = "https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()

-- Закрываем прошлый запуск этого скрипта (его цикл и окно), чтобы старая версия не продолжала работать.
if getgenv().MikiPrevLibrary then
    pcall(function()
        getgenv().MikiPrevLibrary:Unload()
    end)
end
getgenv().MikiPrevLibrary = Library

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Window = Library:CreateWindow({
    Title = "Speed | Orbs v5 (touch, no teleport)",
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2
})

local Tabs = {
    Main = Window:AddTab("Main"),
    Orbs = Window:AddTab("Orbs")
}

-- =========================================
-- SPEED
-- =========================================

local Speed = {
    Enabled = false,
    Value = 50,        -- нужная скорость
    Original = 16,     -- запоминается при включении, чтобы вернуть при выключении
}

local SpeedConnection = nil

local function GetHumanoid()
    local Character = LocalPlayer.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end

local function StartSpeed()
    if SpeedConnection then
        return
    end

    local Humanoid = GetHumanoid()
    if Humanoid then
        Speed.Original = Humanoid.WalkSpeed
    end

    -- Каждый кадр возвращаем нужную скорость, чтобы игра её не сбрасывала.
    -- Humanoid берём заново каждый раз, поэтому работает и после респавна.
    SpeedConnection = RunService.Heartbeat:Connect(function()
        local Hum = GetHumanoid()

        if Hum and Hum.WalkSpeed ~= Speed.Value then
            Hum.WalkSpeed = Speed.Value
        end
    end)
end

local function StopSpeed()
    if SpeedConnection then
        SpeedConnection:Disconnect()
        SpeedConnection = nil
    end

    local Humanoid = GetHumanoid()
    if Humanoid then
        Humanoid.WalkSpeed = Speed.Original
    end
end

local SpeedBox = Tabs.Main:AddLeftGroupbox("Speed")

SpeedBox:AddToggle("SpeedToggle", {
    Text = "Speed",
    Default = false,
    Tooltip = "Держит скорость постоянно, игра её не сбрасывает",

    Callback = function(Value)
        Speed.Enabled = Value

        if Value then
            StartSpeed()
        else
            StopSpeed()
        end
    end
})

SpeedBox:AddInput("SpeedValue", {
    Text = "Speed value",
    Default = tostring(Speed.Value),
    Numeric = true,
    Finished = true, -- применяется по Enter
    Placeholder = "50",
    Tooltip = "Введи число и нажми Enter",

    Callback = function(Value)
        local Number = tonumber(Value)

        if Number then
            Speed.Value = math.clamp(Number, 0, 1000)
        end
    end
})

-- =========================================
-- ORBS (удалённое касание, без телепорта)
-- =========================================

local OrbPassDelay = 0.1  -- пауза между полными проходами
local DebugOrbs = true    -- показывать в окне, что скрипт нашёл (поставь false, когда заработает)

local Orb = {
    Enabled = false,
    Token = 0, -- защита от запуска двух циклов одновременно
}

local function GetRoot()
    local Character = LocalPlayer.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function TouchPart(Part, Root)
    firetouchinterest(Root, Part, 0)
    firetouchinterest(Root, Part, 1)
end

local function StartOrbs()
    Orb.Token = Orb.Token + 1
    local MyToken = Orb.Token

    local function IsActive()
        return Orb.Enabled and Orb.Token == MyToken
    end

    local Reported = false

    task.spawn(function()
        while IsActive() do
            local Root = GetRoot()
            local Debris = workspace:FindFirstChild("__DEBRIS")
            local Orbs = Debris and Debris:FindFirstChild("HatchWarOrbs")
            local Children = Orbs and Orbs:GetChildren() or {}

            if DebugOrbs and not Reported then
                Reported = true

                if not Orbs then
                    Library:Notify("Orbs: папка workspace.__DEBRIS.HatchWarOrbs не найдена", 6)
                elseif #Children == 0 then
                    Library:Notify("Orbs: папка найдена, но внутри пусто", 6)
                else
                    Library:Notify(
                        string.format(
                            "Orbs: найдено %d | первый: %s (%s)",
                            #Children,
                            Children[1].Name,
                            Children[1].ClassName
                        ),
                        8
                    )
                end
            end

            if Root and #Children > 0 then
                local Count = 0

                for _, Object in ipairs(Children) do
                    if not IsActive() then
                        break
                    end

                    -- касаемся каждой парты внутри модели орба
                    if Object.Parent then
                        local Parts = Object:IsA("BasePart") and {Object} or Object:GetDescendants()

                        for _, Part in ipairs(Parts) do
                            if Part:IsA("BasePart") and Part.Parent then
                                pcall(TouchPart, Part, Root)

                                -- чтобы при большом количестве парт игра не зависала
                                Count = Count + 1
                                if Count % 50 == 0 then
                                    task.wait()
                                end
                            end
                        end
                    end
                end
            end

            task.wait(OrbPassDelay)
        end
    end)
end

local OrbBox = Tabs.Orbs:AddLeftGroupbox("Orbs")

OrbBox:AddToggle("OrbToggle", {
    Text = "Auto touch Orbs",
    Default = false,
    Tooltip = "Удалённо касается всех парт орбов в workspace.__DEBRIS.HatchWarOrbs (без телепорта)",

    Callback = function(Value)
        if Value and not firetouchinterest then
            Library:Notify("firetouchinterest не поддерживается твоим экзекьютором", 5)
            return
        end

        Orb.Enabled = Value

        if Value then
            StartOrbs()
        else
            Orb.Token = Orb.Token + 1
        end
    end
})

Library:OnUnload(function()
    Speed.Enabled = false
    StopSpeed()

    Orb.Enabled = false
    Orb.Token = Orb.Token + 1
end)
