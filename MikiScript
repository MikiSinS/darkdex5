local function SetNoClip(State)
    if State then
        if NoClipConnection then
            return
        end

        NoClipConnection = RunService.Heartbeat:Connect(function()
            if not Enabled then
                return
            end

            if Character and Character.Parent then
                for _, Part in ipairs(Character:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.CanCollide = false
                        Part.CanTouch = false
                    end
                end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end

        if Character and Character.Parent then
            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = true
                    Part.CanTouch = true
                end
            end
        end
    end
end

local function StopEggFlight()
    if EggFlightConnection then
        EggFlightConnection:Disconnect()
        EggFlightConnection = nil
    end
end

local function StartEggFlight(Handle)
    StopEggFlight()

    if not Handle or not Handle.Parent or not pl or not pl.Parent then
        return false
    end

    pl.Anchored = true

    local function LockToEgg()
        if not Enabled or not Handle.Parent or not pl or not pl.Parent then
            return
        end

        local TargetPosition = Handle.Position + Vector3.new(0, EggFlightHeight, 0)

        pl.Anchored = true
        pl.AssemblyLinearVelocity = Vector3.zero
        pl.AssemblyAngularVelocity = Vector3.zero
        pl.CFrame = CFrame.new(TargetPosition)

        if Character and Character.Parent then
            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                    Part.CanTouch = false
                end
            end
        end
    end

    LockToEgg()

    EggFlightConnection = RunService.Heartbeat:Connect(LockToEgg)

    return true
end

local function DisableFlight()
    StopEggFlight()

    if pl and pl.Parent then
        pl.Anchored = false
        pl.AssemblyLinearVelocity = Vector3.zero
        pl.AssemblyAngularVelocity = Vector3.zero
    end
end

local function SmoothTeleport(targetCFrame, duration)
    if not pl or not pl.Parent then
        return false
    end

    pl.Anchored = true

    local Tween = TweenService:Create(
        pl,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    Tween:Play()
    Tween.Completed:Wait()

    return true
end

local function GetOwnerValue(Owner)
    if Owner:IsA("ObjectValue") then
        return Owner.Value
    end

    if Owner:IsA("StringValue") then
        return Owner.Value
    end

    return nil
end

local function IsOurPlot(Owner)
    local OwnerValue = GetOwnerValue(Owner)

    if not OwnerValue then
        return false
    end

    if Owner:IsA("ObjectValue") then
        return OwnerValue == LocalPlayer
    end

    if Owner:IsA("StringValue") then
        return OwnerValue == LocalPlayer.Name
            or OwnerValue == tostring(LocalPlayer.UserId)
    end

    return false
end

local function GetOwnBaseplate()
    local Plots = workspace:FindFirstChild("Plots")

    if not Plots then
        return nil
    end

    for _, plot in ipairs(Plots:GetChildren()) do
        local Data = plot:FindFirstChild("Data")

        if Data then
            local Owner = Data:FindFirstChild("Owner")

            if Owner and IsOurPlot(Owner) then
                local Baseplate = plot:FindFirstChild("Baseplate", true)

                if Baseplate and Baseplate:IsA("BasePart") then
                    return Baseplate
                end
            end
        end
    end

    return nil
end

local function TeleportToOwnPlot()
    if not pl or not pl.Parent then
        return false
    end

    local Baseplate = GetOwnBaseplate()

    if not Baseplate then
        return false
    end

    local BasePosition = Baseplate.Position
    local CurrentPosition = pl.Position

    local BaseY = BasePosition.Y
    local CurrentY = CurrentPosition.Y

    if BaseY < CurrentY then
        pl.Anchored = true

        pl.CFrame = CFrame.new(
            CurrentPosition.X,
            BaseY + HeightAboveBase,
            CurrentPosition.Z
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        local FlyPosition = Vector3.new(
            BasePosition.X,
            BaseY + HeightAboveBase,
            BasePosition.Z
        )

        SmoothTeleport(
            CFrame.new(FlyPosition),
            BaseTeleportTime
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        DisableFlight()
    else
        local FlyPosition = Vector3.new(
            BasePosition.X,
            CurrentY,
            BasePosition.Z
        )

        SmoothTeleport(
            CFrame.new(FlyPosition),
            BaseTeleportTime
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        DisableFlight()
    end

    return true
end

local function CollectEgg(egg)
    if not egg or not egg.Parent then
        return
    end

    local Handle = egg:FindFirstChild("Handle")

    if not Handle or not Handle:IsA("BasePart") then
        return
    end

    StartEggFlight(Handle)

    if not Enabled or not egg.Parent or not Handle.Parent then
        DisableFlight()
        return
    end

    while egg.Parent and Enabled and Handle.Parent do
        local CycleStart = tick()

        PressE()

        while tick() - CycleStart < EInterval do
            if not Enabled or not egg.Parent or not Handle.Parent then
                break
            end

            task.wait()
        end
    end

    StopEggFlight()

    if not Enabled then
        DisableFlight()
        return
    end

    task.wait(EggWaitAfter)

    if not Enabled then
        DisableFlight()
        return
    end

    TeleportToOwnPlot()
end

