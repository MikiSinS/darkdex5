local NoClipConnection = nil
local EggHoverConnection = nil

local function StopEggHover()
    if EggHoverConnection then
        EggHoverConnection:Disconnect()
        EggHoverConnection = nil
    end
end

local function StartEggHover(Handle)
    StopEggHover()

    if not Handle or not Handle.Parent or not pl or not pl.Parent then
        return
    end

    local HoverPosition = Handle.Position + Vector3.new(0, 2, 0)

    EggHoverConnection = RunService.Heartbeat:Connect(function()
        if not Enabled or not Handle.Parent or not pl.Parent then
            return
        end

        pl.Anchored = true
        pl.AssemblyLinearVelocity = Vector3.zero
        pl.AssemblyAngularVelocity = Vector3.zero
        pl.CFrame = CFrame.new(HoverPosition)
    end)
end

local function SetNoClip(State)
    if State then
        if NoClipConnection then
            return
        end

        NoClipConnection = RunService.Stepped:Connect(function()
            if not Enabled then
                return
            end

            if Character and Character.Parent then
                for _, Part in ipairs(Character:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end
    end
end

local function PressE(Prompt)
    local Released = false

    -- Берём клавишу прямо из подсказки (если там не E), иначе E.
    local KeyCode = Enum.KeyCode.E
    if Prompt and Prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then
        KeyCode = Prompt.KeyboardKeyCode
    end

    -- Держим не меньше, чем нужно самой подсказке.
    local HoldTime = EHoldTime
    if Prompt then
        HoldTime = math.max(EHoldTime, Prompt.HoldDuration + 0.3)

        -- Подсказка может не срабатывать из-за дистанции или "линии видимости".
        pcall(function()
            Prompt.RequiresLineOfSight = false
            Prompt.MaxActivationDistance = math.max(Prompt.MaxActivationDistance, 25)
        end)
    end

    if DebugPrompt then
        pcall(function()
            local Info = "Prompt NOT FOUND"

            if Prompt then
                Info = string.format(
                    "Prompt: %s | key=%s | hold=%.2f | enabled=%s | fire=%s",
                    Prompt.Parent and Prompt.Parent.Name or "?",
                    Prompt.KeyboardKeyCode.Name,
                    Prompt.HoldDuration,
                    tostring(Prompt.Enabled),
                    tostring(fireproximityprompt ~= nil)
                )
            end

            Library:Notify(Info, 4)
        end)
    end

    local function ReleaseE()
        if Released then
            return
        end

        Released = true

        if Prompt then
            pcall(function()
                Prompt:InputHoldEnd()
            end)
        end

        pcall(function()
            VirtualInputManager:SendKeyEvent(
                false,
                KeyCode,
                false,
                game
            )
        end)
    end

    -- Зажимаем и через саму подсказку, и клавишей (страховка).
    if Prompt then
        pcall(function()
            Prompt:InputHoldBegin()
        end)
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            true,
            KeyCode,
            false,
            game
        )
    end)

    local EndTime = tick() + HoldTime

    while tick() < EndTime do
        if not Enabled then
            break
        end

        task.wait(0.05)
    end

    -- Если яйцо всё ещё на месте (зажатие не сработало) - пробуем функцию экзекьютора.
    if Enabled and Prompt and Prompt.Parent and fireproximityprompt then
        pcall(function()
            fireproximityprompt(Prompt)
        end)
    end

    ReleaseE()
end

local function DisableFlight()
    if pl and pl.Parent then
        pl.Anchored = false
    end
end

local function SmoothTeleport(targetCFrame, duration)
    if not pl or not pl.Parent then
        return false
    end

    pl.Anchored = true

    local Tween = TweenService:Create(
        pl,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    Tween:Play()
    Tween.Completed:Wait()

    return true
end

local function GetOwnerValue(Owner)
    if Owner:IsA("ObjectValue") then
        return Owner.Value
    end

    if Owner:IsA("StringValue") then
        return Owner.Value
    end

    return nil
end

local function IsOurPlot(Owner)
    local OwnerValue = GetOwnerValue(Owner)

    if not OwnerValue then
        return false
    end

    if Owner:IsA("ObjectValue") then
        return OwnerValue == LocalPlayer
    end

    if Owner:IsA("StringValue") then
        return OwnerValue == LocalPlayer.Name
            or OwnerValue == tostring(LocalPlayer.UserId)
    end

    return false
end

local function GetOwnBaseplate()
    local Plots = workspace:FindFirstChild("Plots")

    if not Plots then
        return nil
    end

    for _, plot in ipairs(Plots:GetChildren()) do
        local Data = plot:FindFirstChild("Data")

        if Data then
            local Owner = Data:FindFirstChild("Owner")

            if Owner and IsOurPlot(Owner) then
                local Baseplate = plot:FindFirstChild("Baseplate", true)

                if Baseplate and Baseplate:IsA("BasePart") then
                    return Baseplate
                end
            end
        end
    end

    return nil
end

local function TeleportToOwnPlot()
    if not pl or not pl.Parent then
        return false
    end

    local Baseplate = GetOwnBaseplate()

    if not Baseplate then
        return false
    end

    StopEggHover()
    SetNoClip(true)

    local BasePosition = Baseplate.Position
    local TargetPosition = Vector3.new(
        BasePosition.X,
        BasePosition.Y + HeightAboveBase,
        BasePosition.Z
    )

    pl.Anchored = true
    pl.AssemblyLinearVelocity = Vector3.zero
    pl.AssemblyAngularVelocity = Vector3.zero

    local Tween = TweenService:Create(
        pl,
        TweenInfo.new(
            BaseTeleportTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = CFrame.new(TargetPosition)
        }
    )

    Tween:Play()

    while Tween.PlaybackState == Enum.PlaybackState.Playing do
        if not Enabled then
            Tween:Cancel()
            pl.Anchored = false
            SetNoClip(false)
            return false
        end

        pl.Anchored = true
        pl.AssemblyLinearVelocity = Vector3.zero
        pl.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end

    if not Enabled then
        pl.Anchored = false
        SetNoClip(false)
        return false
    end

    pl.CFrame = CFrame.new(TargetPosition)
    pl.Anchored = false
    pl.AssemblyLinearVelocity = Vector3.zero
    pl.AssemblyAngularVelocity = Vector3.zero

    SetNoClip(false)

    return true
end

local function GetEggPart(egg)
    if not egg or not egg.Parent then
        return nil
    end

    -- Для моделей вроде Cherub сначала ищем саму точку взаимодействия E.
    local Prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)

    if Prompt then
        if Prompt.Parent:IsA("BasePart") then
            return Prompt.Parent
        end

        if Prompt.Parent:IsA("Attachment") and Prompt.Parent.Parent:IsA("BasePart") then
            return Prompt.Parent.Parent
        end
    end

    local Handle = egg:FindFirstChild("Handle", true)

    if Handle and Handle:IsA("BasePart") then
        return Handle
    end

    if egg:IsA("Model") then
        if egg.PrimaryPart and egg.PrimaryPart:IsA("BasePart") then
            return egg.PrimaryPart
        end

        for _, Part in ipairs(egg:GetDescendants()) do
            if Part:IsA("BasePart") then
                return Part
            end
        end

        return nil
    end

    if egg:IsA("BasePart") then
        return egg
    end

    return nil
end
local function CollectEgg(egg)
    if not egg or not egg.Parent then
        return
    end

    local Handle = GetEggPart(egg)

    if not Handle then
        return
    end

    -- Быстро телепортируемся к яйцу и зависаем над ним.
    SetNoClip(true)
    StartEggHover(Handle)
    pl.Anchored = true

    -- Ждём, пока персонаж реально окажется у яйца, и только потом жмём E.
    local HoverPosition = Handle.Position + Vector3.new(0, 2, 0)
    local ArriveEnd = tick() + 1.5

    while Enabled
        and tick() < ArriveEnd
        and pl and pl.Parent
        and (pl.Position - HoverPosition).Magnitude > 3 do
        task.wait()
    end

    task.wait(0.15)

    -- Одно полное зажатие E на подсказке яйца.
    local Prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
    PressE(Prompt)

    if not Enabled then
        StopEggHover()
        DisableFlight()
        SetNoClip(false)
        return
    end

    -- После сбора обязательно возвращаемся на свой плот.
    StopEggHover()

    local Baseplate = GetOwnBaseplate()
    if not Baseplate then
        pl.Anchored = false
        SetNoClip(false)
        return
    end

    local TargetPosition = Baseplate.Position + Vector3.new(0, HeightAboveBase, 0)

    SetNoClip(true)
    pl.Anchored = true
    pl.AssemblyLinearVelocity = Vector3.zero
    pl.AssemblyAngularVelocity = Vector3.zero

    local Tween = TweenService:Create(
        pl,
        TweenInfo.new(
            BaseTeleportTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {CFrame = CFrame.new(TargetPosition)}
    )

    Tween:Play()

    while Tween.PlaybackState == Enum.PlaybackState.Playing and Enabled do
        pl.Anchored = true
        pl.AssemblyLinearVelocity = Vector3.zero
        pl.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end

    if not Enabled then
        Tween:Cancel()
        pl.Anchored = false
        SetNoClip(false)
        return
    end

    pl.CFrame = CFrame.new(TargetPosition)
    pl.Anchored = false
    pl.AssemblyLinearVelocity = Vector3.zero
    pl.AssemblyAngularVelocity = Vector3.zero

    -- На плоту снова нормальная коллизия.
    SetNoClip(false)

    -- Небольшая пауза перед поиском следующего выбранного яйца.
    task.wait(0.1)
end

MainBox:AddToggle("Enable1", {
    Text = "Enable",
    Default = false,

    Callback = function(Value)
        Enabled = Value

        if not Value then
            StopEggHover()
            DisableFlight()
            SetNoClip(false)
            return
        end

        SetNoClip(true)

        task.spawn(function()
            while Enabled do
                local RenderedEggs = workspace:FindFirstChild("RenderedEggs")

                if not RenderedEggs then
                    task.wait(0.5)
                    continue
                end

                local HasSelectedEgg = false

                for _, egg in ipairs(RenderedEggs:GetChildren()) do
                    if SelectedEggs[egg.Name] then
                        HasSelectedEgg = true
                        break
                    end
                end

                if not HasSelectedEgg then
                    task.wait(0.5)
                    continue
                end

                for _, egg in ipairs(RenderedEggs:GetChildren()) do
                    if not Enabled then
                        break
                    end

                    if SelectedEggs[egg.Name] then
                        CollectEgg(egg)
                    end
                end

                task.wait(0.1)
            end

            DisableFlight()
        end)
    end
})

