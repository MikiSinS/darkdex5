local WebhookURL = ""
local WebhookConfirmed = false

local function SendWebhook(EggName)
    if not WebhookConfirmed or WebhookURL == "" then
        return
    end

    local Request = request
        or http_request
        or (syn and syn.request)

    if not Request then
        warn("MikiGui: HTTP request is not supported")
        return
    end

    local Payload = {
        username = "MikiGui",
        embeds = {{
            title = "🥚 AutoEgg",
            description = "Яйцо поймано и игрок телепортировался на свою базу.",
            color = 5763719,
            fields = {
                {
                    name = "Egg",
                    value = tostring(EggName),
                    inline = true
                },
                {
                    name = "Player",
                    value = LocalPlayer.Name,
                    inline = true
                },
                {
                    name = "Status",
                    value = "Teleported to base",
                    inline = false
                }
            }
        }}
    }

    local HttpService = game:GetService("HttpService")

    pcall(function()
        Request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(Payload)
        })
    end)
end

