local function GetLuckValue(egg)
    if not egg then
        return "?"
    end

    local Luck = egg:FindFirstChild("Luck", true)

    if Luck then
        if Luck:IsA("ValueBase") then
            return tostring(Luck.Value)
        end

        local AttributeLuck = Luck:GetAttribute("Value")
        if AttributeLuck ~= nil then
            return tostring(AttributeLuck)
        end
    end

    local AttributeLuck = egg:GetAttribute("Luck")

    if AttributeLuck ~= nil then
        return tostring(AttributeLuck)
    end

    return "?"
end

local list = {}
local EggDisplayToName = {}
local usr = {}

for _, egg1 in ipairs(eggfolder:GetChildren()) do
    if not usr[egg1.Name] then
        usr[egg1.Name] = true

        local Luck = GetLuckValue(egg1)
        local DisplayName = egg1.Name .. " | Luck: " .. Luck

        table.insert(list, DisplayName)
        EggDisplayToName[DisplayName] = egg1.Name
    end
end

local MainBox = Tabs.Egg:AddLeftGroupbox("AutoEgg")

local SelectedEggs = {}
local Enabled = false

local Dropdown = MainBox:AddDropdown("AutoEgg", {
    Values = list,
    Default = {},
    Multi = true,
    Text = "Choose Eggs",

    Callback = function(Value)
        SelectedEggs = {}

        for DisplayName, Selected in pairs(Value) do
            if Selected then
                local EggName = EggDisplayToName[DisplayName]

                if EggName then
                    SelectedEggs[EggName] = true
                end
            end
        end
    end
})

local NoClipConnection = nil

local function SetNoClip(State)
    if State then
        if NoClipConnection then
            return
        end

        NoClipConnection = RunService.Stepped:Connect(function()
            if not Enabled then
                return
            end

            if Character and Character.Parent then
                for _, Part in ipairs(Character:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end
    end
end

local function PressE()
    VirtualInputManager:SendKeyEvent(
        true,
        Enum.KeyCode.E,
        false,
        game
    )

    task.wait(EHoldTime)

    VirtualInputManager:SendKeyEvent(
        false,
        Enum.KeyCode.E,
        false,
        game
    )
end

local function DisableFlight()
    if pl and pl.Parent then
        pl.Anchored = false
    end
end

local function SmoothTeleport(targetCFrame, duration)
    if not pl or not pl.Parent then
        return false
    end

    pl.Anchored = true

    local Tween = TweenService:Create(
        pl,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    Tween:Play()
    Tween.Completed:Wait()

    return true
end

local function GetOwnerValue(Owner)
    if Owner:IsA("ObjectValue") then
        return Owner.Value
    end

    if Owner:IsA("StringValue") then
        return Owner.Value
    end

    return nil
end

local function IsOurPlot(Owner)
    local OwnerValue = GetOwnerValue(Owner)

    if not OwnerValue then
        return false
    end

    if Owner:IsA("ObjectValue") then
        return OwnerValue == LocalPlayer
    end

    if Owner:IsA("StringValue") then
        return OwnerValue == LocalPlayer.Name
            or OwnerValue == tostring(LocalPlayer.UserId)
    end

    return false
end

local function GetOwnBaseplate()
    local Plots = workspace:FindFirstChild("Plots")

    if not Plots then
        return nil
    end

    for _, plot in ipairs(Plots:GetChildren()) do
        local Data = plot:FindFirstChild("Data")

        if Data then
            local Owner = Data:FindFirstChild("Owner")

            if Owner and IsOurPlot(Owner) then
                local Baseplate = plot:FindFirstChild("Baseplate", true)

                if Baseplate and Baseplate:IsA("BasePart") then
                    return Baseplate
                end
            end
        end
    end

    return nil
end

local function TeleportToOwnPlot()
    if not pl or not pl.Parent then
        return false
    end

    local Baseplate = GetOwnBaseplate()

    if not Baseplate then
        return false
    end

    local BasePosition = Baseplate.Position
    local CurrentPosition = pl.Position

    local BaseY = BasePosition.Y
    local CurrentY = CurrentPosition.Y

    if BaseY < CurrentY then
        pl.Anchored = true

        pl.CFrame = CFrame.new(
            CurrentPosition.X,
            BaseY + HeightAboveBase,
            CurrentPosition.Z
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        local FlyPosition = Vector3.new(
            BasePosition.X,
            BaseY + HeightAboveBase,
            BasePosition.Z
        )

        SmoothTeleport(
            CFrame.new(FlyPosition),
            BaseTeleportTime
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        DisableFlight()
    else
        local FlyPosition = Vector3.new(
            BasePosition.X,
            CurrentY,
            BasePosition.Z
        )

        SmoothTeleport(
            CFrame.new(FlyPosition),
            BaseTeleportTime
        )

        if not Enabled then
            DisableFlight()
            return false
        end

        DisableFlight()
    end

    return true
end

local function CollectEgg(egg)
    if not egg or not egg.Parent then
        return
    end

    local Handle = egg:FindFirstChild("Handle")

    if not Handle or not Handle:IsA("BasePart") then
        return
    end

    DisableFlight()

    pl.CFrame = Handle.CFrame

    task.wait(0.1)

    if not Enabled or not egg.Parent then
        return
    end

    while egg.Parent and Enabled do
        if Handle.Parent then
            pl.CFrame = Handle.CFrame
        else
            break
        end

        PressE()

        local Remaining = EInterval - EHoldTime
        if Remaining > 0 then
            task.wait(Remaining)
        end
    end

    if not Enabled then
        return
    end

    task.wait(EggWaitAfter)

    if not Enabled then
        return
    end

    TeleportToOwnPlot()
end

MainBox:AddToggle("Enable1", {
    Text = "Enable",
    Default = false,

    Callback = function(Value)
        Enabled = Value

        if not Value then
            DisableFlight()
            SetNoClip(false)
            return
        end

        SetNoClip(true)

        task.spawn(function()
            while Enabled do
                local RenderedEggs = workspace:FindFirstChild("RenderedEggs")

                if not RenderedEggs then
                    task.wait(0.5)
                    continue
                end

                local HasSelectedEgg = false

                for _, egg in ipairs(RenderedEggs:GetChildren()) do
                    if SelectedEggs[egg.Name] then
                        HasSelectedEgg = true
                        break
                    end
                end

                if not HasSelectedEgg then
                    task.wait(0.5)
                    continue
                end

                for _, egg in ipairs(RenderedEggs:GetChildren()) do
                    if not Enabled then
                        break
                    end

                    if SelectedEggs[egg.Name] then
                        CollectEgg(egg)
                    end
                end

                task.wait(0.1)
            end

            DisableFlight()
        end)
    end
})

